# Core application variables are documented in the project deployment configuration.

# Outbound email and abandoned-cart automation stay inactive until a real SMTP
# provider and production scheduler are available. See Pending.md.
EMAIL_DELIVERY_ENABLED=true
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Generate a long random secret when a production scheduler is available.
CRON_SECRET=
ABANDONED_CART_DELAY_HOURS=2
ABANDONED_CART_CRON_CONFIGURED=false

# Choose the provider in Admin > Email Marketing, then configure its server credentials.
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_LIST_ID=

BREVO_API_KEY=
BREVO_LIST_ID=

KLAVIYO_API_KEY=
KLAVIYO_LIST_ID=
KLAVIYO_API_REVISION=2026-07-15

# Optional WooCommerce customer synchronization
WOOCOMMERCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
